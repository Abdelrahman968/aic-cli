{
  "name": "@aic/cli",
  "version": "1.1.0",
  "description": "Provider-agnostic AI coding agent for Git: Conventional Commit messages, repo analysis and safe Git automation from your terminal.",
  "keywords": [
    "ai",
    "cli",
    "git",
    "commit",
    "conventional-commits",
    "ollama",
    "openai",
    "anthropic",
    "gemini",
    "openrouter",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "AIC contributors",
  "type": "module",
  "bin": {
    "aic": "dist/index.js"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdelrahman968/aic-cli/aic.git"
  },
  "bugs": {
    "url": "https://github.com/Abdelrahman968/aic-cli/aic/issues"
  },
  "homepage": "https://github.com/Abdelrahman968/aic-cli/aic#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}